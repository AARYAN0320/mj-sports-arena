// firestore.rules
// Paste this into Firebase Console → Firestore → Rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookings/{bookingId} {
      // Anyone can read bookings (needed to show booked slots)
      allow read: if true;

      // Anyone can create a booking (users booking slots)
      allow create: if request.resource.data.keys().hasAll(['sport', 'date', 'slot', 'name', 'phone', 'amount', 'createdAt'])
                    && request.resource.data.sport in ['cricket', 'pickleball']
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.phone is string;

      // Only allow delete (cancel) from admin — controlled via admin password in app
      // For extra security, you can add Firebase Auth later
      allow delete: if true;
      allow update: if false;
    }
  }
}
